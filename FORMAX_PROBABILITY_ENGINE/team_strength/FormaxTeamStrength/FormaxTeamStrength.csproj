<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone offline tool. Deliberately NOT added to Formax.slnx so the production build is
       untouched. No NuGet packages: only the BCL, so it restores and builds without network. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FormaxTeamStrength</AssemblyName>
    <RootNamespace>Formax.TeamStrength</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
