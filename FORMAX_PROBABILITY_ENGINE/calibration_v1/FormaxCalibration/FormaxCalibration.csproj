<Project Sdk="Microsoft.NET.Sdk">

  <!-- Research / calibration harness. NOT added to Formax.slnx, no NuGet packages, no production wiring. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FormaxCalibration</AssemblyName>
    <RootNamespace>Formax.Calibration</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- The frozen model under calibration is reused as-is; no engine project is modified. -->
    <ProjectReference Include="..\..\model_validation_v2\FormaxModelValidation\FormaxModelValidation.csproj" />
  </ItemGroup>

</Project>
