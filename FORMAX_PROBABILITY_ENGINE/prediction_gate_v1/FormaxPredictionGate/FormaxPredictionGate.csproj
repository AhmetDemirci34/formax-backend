<Project Sdk="Microsoft.NET.Sdk">

  <!-- Research output-contract harness. NOT added to Formax.slnx, no NuGet packages, no production DB. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FormaxPredictionGate</AssemblyName>
    <RootNamespace>Formax.Prediction</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The frozen model is consumed as-is; no engine project is modified. -->
    <ProjectReference Include="..\..\model_validation_v2\FormaxModelValidation\FormaxModelValidation.csproj" />
  </ItemGroup>

</Project>
