    { "field": "extra_time_or_shootout_as_input", "featureId": "F014/F015", "reason": "in-match information" },
    { "field": "match_status_as_input", "featureId": "F016", "reason": "reveals that the match went to extra time" },
    { "field": "source_elo_rating", "featureId": "F601", "reason": "third-party pre-computed rating with unknown timing" },
    { "field": "source_form_columns", "featureId": "F602", "reason": "third-party pre-computed form with unknown timing" },
    { "field": "final_league_standing", "featureId": "F603", "reason": "uses matches played after the prediction date" },
    { "field": "season_aggregate_stats", "featureId": "F604", "reason": "full-season aggregate leaks the future" },
    { "field": "data_quality_flag", "featureId": "F605", "reason": "pipeline artefact, correlates with season and source not with football" }
  ]
}
