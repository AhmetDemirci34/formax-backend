    { "field": "starting_lineup", "featureId": "F301", "status": "FUTURE", "reachablePct": 0.0, "requirement": "snapshot timestamped BEFORE kickoff" },
    { "field": "injuries", "featureId": "F302", "status": "FUTURE", "reachablePct": 0.0, "requirement": "snapshot timestamped BEFORE kickoff" },
